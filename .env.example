BOT_TOKEN=
OWNER_ID=
CHAT_ID=
DATABASE_PATH=data/scheduler.sqlite3
# Optional numeric pool channel for forwarded scheduling and source status replies;
# must differ from destination. No channel history is read.
POOL_CHAT_ID=
# Optional: If WEBHOOK_URL is left empty/unset, the bot will NOT configure a
# webhook and will automatically start in Long-Polling mode instead.
# Must be HTTPS on port 443, 80, 88, or 8443 per Telegram limits.
WEBHOOK_URL=
# Secret token for verifying Telegram webhook requests (1-256 characters)
WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8443
WEBHOOK_PATH=/webhook
